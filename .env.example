# Whisper model (HuggingFace model ID)
WHISPER_MODEL=Systran/faster-whisper-large-v3

# Inference device: cuda or cpu
DEVICE=cuda

# GPU compute type
COMPUTE_TYPE=int8_float16

# GPU queue settings
GPU_TIMEOUT=120
GPU_CONCURRENCY=1

# Server
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# Default language for transcription
DEFAULT_LANGUAGE=fr

# CORS (comma-separated origins, or * for all)
CORS_ALLOW_ORIGINS=["*"]
