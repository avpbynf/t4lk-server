# Database connection
DATABASE_URL=postgresql+asyncpg://whisper:whisper@localhost:5432/whisper

# Admin token for managing API tokens via /admin endpoints
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=

# Whisper model to use (HuggingFace model ID)
# Options: Systran/faster-whisper-large-v3, deepdml/faster-whisper-large-v3-turbo-ct2, etc.
WHISPER_MODEL=Systran/faster-whisper-large-v3
